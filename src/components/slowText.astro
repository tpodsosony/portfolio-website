---
const { message = 'Hee-Ho!', id = 'Undefined', targetid = 'Undefined'} = Astro.props;
import '../styles/jackfrost.css';
import DialogueButton from '../components/dialogueButton.astro';

---

<!-- Store the message prop as a data attribute. -->
<slow-text data-message={message} data-id={id} data-targetid = {targetid}>
</slow-text>
<p id = {id}></p>


<script>
  

  class SlowText extends HTMLElement {
    connectedCallback() {
      var curr = 0;
      var message = this.dataset.message || "Undefined";
      var id = this.dataset.id || "Undefined";
      var targetid = this.dataset.targetid || "Undefined";

      var Write = function write(){
          var elem = document.getElementById(id);
          elem.textContent += message.charAt(curr);
          curr++;
          if (curr < message.length)
              window.setTimeout(write, 50);
      };
      // Read the message from the data attribute.
      if (targetid === 'Undefined'){
        Write();
      }
      else{
        const button = document.getElementById(targetid);
        button?.addEventListener('click', () => {
        Write();
        });
      }
        
    }
  }

  customElements.define('slow-text', SlowText);
</script>

<style>
    .button{
        background: #2e2e2e;
        padding: 6px;
        color: #fff;
        margin-bottom: 30px;
        width: 50%;
        font-size: 24px;
        box-shadow: 0px 5px black, 0px -5px black, 5px 0px black, -5px 0px black, 0px 10px #00000038, 5px 5px #00000038, -5px 5px #00000038, inset 0px 5px #ffffff1f, inset 0px -5px #00000030;
        cursor: pointer;
        margin: auto;
    }
    .button:active{
        transform: translateY(5px);
        box-shadow: 0px 5px black, 0px -5px black, 5px 0px black, -5px 0px black,inset 0px 5px #00000038;
    }
    slow-text{
        text-align: center;
        margin: auto;
    }
</style>