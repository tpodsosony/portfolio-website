---
import '../styles/jackfrost.css';

import SlowText from '../components/slowText.astro';
import JackFrost from '../assets/jackFrost/JFSprite.gif';
import DialogueButton from '../components/dialogueButton.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Hee-Ho!</title>
	</head>
	
<body>
    <div class = "container">
        <img src={JackFrost.src} alt = "this is an image" class = "jfGif"></>
        </br>
        <SlowText message = "Who cares about others, ho???"/>
        <DialogueButton buttonTxt = 'I dont give a hee-ho!', id = "dumb">
            <SlowText message = "From this day forwards, you and I are hee-homeboys!", id= "heeho!", targetid = "dumb"/>
        </DialogueButton>
        <DialogueButton buttonTxt = 'hee-ho!', id = "div.button">
            <SlowText message = "Hee-ho!!!!", id = "tags", targetid = "div.button"/>
        </DialogueButton>

    </div>
</body>

<style>
    body{
        background-image: url(../assets/backgrounds/jackfrostbackground.jpg);
        background-size: cover;
    }

    img{
        display: block;
        margin:auto;
    }
    .container{
        text-align: center;
    }
    #dumb{
        display:none;
    }
    

</style>