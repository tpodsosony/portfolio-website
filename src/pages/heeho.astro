---
import '../styles/jackfrost.css';

import SlowText from '../components/slowText.astro';
import JackFrost from '../assets/jackFrost/JFSprite.gif'; 
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Hee-Ho!</title>
	</head>
<body>
    <div class = "container">
        <img src={JackFrost.src} alt = "this is an image" class = "jfGif"></>
        </br>
        Do you care about others, ho?
        <SlowText message = "From this day forwards, you and I are hee-homeboys!", buttonTxt = "I don't give a hee-ho!"/>

    </div>
</body>

<style>
    body{
        background-image: url(../assets/backgrounds/jackfrostbackground.jpg);
        background-size: cover;
    }

    img{
        display: block;
        margin:auto;
    }
    .container{
        text-align: center;
    }

</style>